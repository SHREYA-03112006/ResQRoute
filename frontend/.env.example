# ResQRoute Frontend Environment Variables
# Copy this file to .env or .env.local and fill in values.
# NEVER commit secret keys to version control.

# Backend API URL (Default Spring Boot port is 8080 or 8081)
VITE_API_BASE_URL=http://localhost:8080/api

# Google Maps JavaScript API Key (Phase 1)
# Required for live Google Maps with road networks and traffic layers.
# Leave blank to run in interactive Fallback Map (Leaflet / OSM) mode.
VITE_GOOGLE_MAPS_API_KEY=
