# ResQ-Route Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resqroute
DB_USER=resqroute
DB_PASSWORD=resqroute

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Backend Server ──────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── TinyFish API ────────────────────────────────────────────────────────────
# Leave TINYFISH_API_KEY empty to run in mock/sample mode.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.tinyfish.io
# Set to false to use the live TinyFish API (requires a valid API key).
TINYFISH_MOCK_MODE=true

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api

# Google Maps JavaScript API Key (Phase 1)
# Required to enable Google Maps with road networks and traffic layers.
# If omitted or left empty, ResQRoute automatically operates in interactive Fallback Map mode.
VITE_GOOGLE_MAPS_API_KEY=
